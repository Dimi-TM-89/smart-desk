# Copy this file to .env and fill in the values.  (.env is NOT committed.)

# --- Local MQTT broker (Mosquitto on the Pi) ---
MQTT_HOST=localhost
MQTT_PORT=1883

# --- ThingSpeak (online dashboard) ---
# Channel → MQTT device: note Client ID, Username and Password
THINGSPEAK_CHANNEL_ID=
THINGSPEAK_CLIENT_ID=
THINGSPEAK_USERNAME=
THINGSPEAK_PASSWORD=

# --- ntfy (push notifications) ---
# Choose a long, hard-to-guess topic name; subscribe to it in the ntfy app
NTFY_TOPIC=

# --- MariaDB ---
DB_HOST=localhost
DB_USER=smartdesk
DB_PASSWORD=
DB_NAME=smartdesk

# --- Demo mode: short timers for the video (1 = on) ---
DEMO_MODE=1
